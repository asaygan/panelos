# ─── Application ─────────────────────────────────────────────
APP_ENV=development
APP_NAME=PanelOS
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://panelos:panelos@localhost:5433/panelos
DATABASE_SYNC_URL=postgresql://panelos:panelos@localhost:5433/panelos

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Auth (generate with: openssl rand -hex 32) ──────────────
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
RATE_LIMIT_ENABLED=true               # throttle auth endpoints (set false in tests)

# ─── CORS (comma-separated; APP_URL + NEXT_PUBLIC_APP_URL auto-added) ─────────
CORS_ORIGINS=http://localhost:3000

# ─── Storage ─────────────────────────────────────────────────
STORAGE_PROVIDER=local                # local | s3 | supabase | azure
STORAGE_LOCAL_PATH=./.storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/api/v1/files

# S3 / MinIO
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=panelos
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=panelos

# Azure
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_CONTAINER=panelos

# ─── Mail (dev = mailhog) ────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PanelOS <no-reply@panelos.app>

# ─── Frontend (Next.js) ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Observability ───────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
LOG_LEVEL=info

# ─── Feature flags ───────────────────────────────────────────
FEATURE_SSO_SAML=false
FEATURE_MFA_REQUIRED=false
FEATURE_OFFLINE_EXPORT=false
