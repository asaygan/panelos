# PanelOS — local development environment.
# Copy to `.env`. Production values live in AWS (App Runner / Amplify), never in git.

# ─── Application ─────────────────────────────────────────────
APP_ENV=development                   # development | test | staging | production
APP_NAME=PanelOS
# Public origin of the web app. Printed QR codes point at ${APP_URL}/q/<token>,
# so in production this MUST be the permanent domain (https://panelos.io).
APP_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://panelos:panelos@localhost:5433/panelos
# Production alternative: set the parts and let the API assemble the URL, so the
# password can be injected from Secrets Manager instead of a plain env var.
# DB_HOST=
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=
# Non-owner role the API assumes per transaction so Postgres row-level security
# is enforced (created by migration 0010). Leave unset to run as the connecting role.
# DB_APP_ROLE=panelos_app

# ─── Auth (generate with: openssl rand -hex 32) ──────────────
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=60
INVITATION_TTL_DAYS=14
# Key for encrypting TOTP seeds at rest. Defaults to a key derived from JWT_SECRET.
# DATA_ENCRYPTION_KEY=
MFA_REQUIRED=false                    # true = every member must enable two-step verification
RATE_LIMIT_ENABLED=true               # throttle auth + QR endpoints (set false in tests)
# One-time: create the first company + owner on an empty database, then turn off.
BOOTSTRAP_ENABLED=false

# ─── CORS (comma-separated; APP_URL is added automatically) ──
CORS_ORIGINS=http://localhost:3000

# ─── Storage ─────────────────────────────────────────────────
STORAGE_PROVIDER=local                # local | s3
STORAGE_LOCAL_PATH=./.storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/api/v1/files
MAX_UPLOAD_BYTES=104857600            # 100 MB

# S3 (production) or MinIO (local). On AWS leave the keys empty: the instance
# role provides credentials. The bucket needs a CORS rule allowing PUT from the
# web origin (browsers upload straight to S3 with presigned URLs).
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=panelos
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ─── Mail ────────────────────────────────────────────────────
EMAIL_PROVIDER=log                    # log (dev: nothing is sent) | smtp | ses
EMAIL_FROM=PanelOS <no-reply@panelos.io>
# ses: uses the instance role; the sender domain must be verified in SES.
# SES_REGION=eu-central-1
# smtp (local MailHog on :1025):
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# ─── Background jobs ─────────────────────────────────────────
SCHEDULER_ENABLED=true                # hourly maintenance-due reminders (in-process)

# ─── Frontend (Next.js) ──────────────────────────────────────
# Browser API path: relative, proxied by the Next rewrite (same-origin → cookies flow).
NEXT_PUBLIC_API_BASE=/api/v1
# Origin of the FastAPI service as seen from the Next.js server (rewrites,
# server actions, middleware). In production: the App Runner URL.
API_INTERNAL_URL=http://localhost:8000
# Public origin of the web app (QR codes rendered in the browser use it).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Observability ───────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
LOG_LEVEL=info
