{
  "name": "@panelos/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PanelOS shared design tokens — CSS variables, Tailwind preset and tiny token/theme helpers.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css",
    "./styles/*"
  ],
  "files": [
    "dist",
    "styles",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tailwind-preset": {
      "types": "./dist/tailwind-preset.d.ts",
      "import": "./dist/tailwind-preset.js"
    },
    "./styles/design-tokens.css": "./styles/design-tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "tailwindcss": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": { "optional": true }
  },
  "devDependencies": {
    "@panelos/config": "workspace:*",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "tailwindcss": "^3.4.0"
  }
}
